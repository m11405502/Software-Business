
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1>Procurement Requirements</h1>
    <p class="text-muted mb-0">
      Contractor: Demo Contractor
    </p>
  </div>

  <a href="/requirements/new" class="btn btn-primary">
    + Add Requirement
  </a>
</div>

<h4>Requirement List</h4>

<div class="table-responsive">
  <table class="table table-bordered table-striped">
    <thead>
      <tr>
        <th>ID</th>
        <th>Requirement Title</th>
        <th>Project</th>
        <th>Category</th>
        <th>Needed By</th>
        <th>Status</th>
      </tr>
    </thead>

    <tbody>
      {{#each requirements}}
      <tr>
        <td>{{requirement_id}}</td>
        <td>
          <a href="/requirements/{{requirement_id}}">
            {{title}}
          </a>
        </td>
        <td>{{project_name}}</td>
        <td>{{category_name}}</td>
        <td>{{needed_by}}</td>
        <td>{{status}}</td>
      </tr>
      {{else}}
      <tr>
        <td colspan="6" class="text-center">
          No procurement requirements found.
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
