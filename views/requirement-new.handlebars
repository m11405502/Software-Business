
<h1>Add Procurement Requirement</h1>

<p class="text-muted">
  Register procurement needs for a construction project.
</p>

<form action="/requirements" method="POST">

  <h4>1. Requirement Information</h4>

  <div class="mb-3">
    <label class="form-label">Project *</label>
    <select name="project_id" class="form-select" required>
      <option value="">Select Project</option>
      {{#each projects}}
        <option value="{{project_id}}">
          {{project_name}}
        </option>
      {{/each}}
    </select>
  </div>

  <div class="mb-3">
    <label class="form-label">Requirement Title *</label>
    <input type="text" name="title"
           class="form-control"
           maxlength="255" required>
  </div>

  <div class="mb-3">
    <label class="form-label">Resource Category *</label>
    <select name="category_id" class="form-select" required>
      <option value="">Select Category</option>
      {{#each categories}}
        <option value="{{category_id}}">
          {{category_name}}
        </option>
      {{/each}}
    </select>
  </div>

  <div class="mb-3">
    <label class="form-label">Needed By</label>
    <input type="date" name="needed_by"
           class="form-control">
  </div>

  <hr class="my-4">

  <h4>2. Requirement Items</h4>
  <p class="text-muted">
    Add one or more items with quantity and unit.
  </p>

  <div id="items"></div>

  <button type="button" id="add-item"
          class="btn btn-outline-primary mb-4">
    + Add Another Item
  </button>

  <hr>

  <a href="/requirements" class="btn btn-secondary">
    Back to Requirements
  </a>

  <button type="submit" class="btn btn-primary">
  Save Requirement
  </button>

</form>

<template id="item-template">
  <div class="item-row border rounded p-3 mb-3">

    <div class="d-flex justify-content-between">
      <h5 class="item-title">Requirement Item</h5>
      <button type="button"
              class="btn btn-sm btn-outline-danger"
              data-remove-item>
        Remove
      </button>
    </div>

    <div class="mb-3">
      <label class="form-label">Item Description *</label>
      <input type="text"
             name="item_description[]"
             class="form-control"
             maxlength="500" required>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Required Quantity *</label>
        <input type="number"
               name="required_qty[]"
               class="form-control"
               min="0.001" step="0.001" required>
      </div>

      <div class="col-md-6 mb-3">
        <label class="form-label">Unit *</label>
        <select name="unit_id[]" class="form-select" required>
          <option value="">Select Unit</option>
          {{#each units}}
            <option value="{{unit_id}}">
              {{unit_code}} - {{unit_name}}
            </option>
          {{/each}}
        </select>
      </div>
    </div>

  </div>
</template>

<script>
  const items = document.getElementById('items');
  const template = document.getElementById('item-template');

  function updateItems() {
    const rows = [...items.querySelectorAll('.item-row')];

    rows.forEach((row, index) => {
      row.querySelector('.item-title').textContent =
        `Requirement Item ${index + 1}`;

      row.querySelector('[data-remove-item]').disabled =
        rows.length === 1;
    });
  }

  document.getElementById('add-item').addEventListener(
    'click', () => {
      if (items.querySelectorAll('.item-row').length >= 30) {
        alert('Maximum 30 items allowed.');
        return;
      }

      items.appendChild(template.content.cloneNode(true));
      updateItems();
    }
  );

  items.addEventListener('click', event => {
    const button = event.target.closest('[data-remove-item]');
    if (!button) return;

    button.closest('.item-row').remove();
    updateItems();
  });

  document.getElementById('add-item').click();
</script>
