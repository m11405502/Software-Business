<h2 class="h4 mb-3">Edit Draft RFQ #{{rfq.rfq_id}}</h2>

<form method="POST" action="/rfqs/{{rfq.rfq_id}}/update" class="card p-4">
  <div class="mb-3">
    <label class="form-label">RFQ Title</label>
    <input type="text" name="title" class="form-control" maxlength="255" value="{{rfq.title}}" required>
  </div>

  <div class="mb-3">
    <label class="form-label">Response Deadline</label>
    <input type="date" name="response_deadline" class="form-control" value="{{rfq.response_deadline}}" required>
  </div>

  <div class="mb-3">
    <label class="form-label">Intended Suppliers</label>
    {{#each providers}}
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="provider_ids" value="{{this.provider_id}}" id="edit_prov_{{this.provider_id}}" {{#if this.selected}}checked{{/if}}>
        <label class="form-check-label" for="edit_prov_{{this.provider_id}}">{{this.provider_name}}</label>
      </div>
    {{/each}}
  </div>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Update Draft</button>
    <a href="/rfqs/{{rfq.rfq_id}}" class="btn btn-secondary">Cancel</a>
  </div>
</form>