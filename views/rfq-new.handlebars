<h2 class="h4 mb-3">Create Draft RFQ</h2>

<form method="POST" action="/rfqs" class="card p-4">
  <div class="mb-3">
    <label class="form-label">Source Requirement</label>
    <select name="requirement_id" class="form-select" required>
      <option value="">-- Select Requirement --</option>
      {{#each requirements}}
        <option value="{{this.requirement_id}}">#{{this.requirement_id}} - {{this.title}} ({{this.project_name}})</option>
      {{/each}}
    </select>
  </div>

  <div class="mb-3">
    <label class="form-label">RFQ Title</label>
    <input type="text" name="title" class="form-control" maxlength="255" required>
  </div>

  <div class="mb-3">
    <label class="form-label">Response Deadline</label>
    <input type="date" name="response_deadline" class="form-control" required>
  </div>

  <div class="mb-3">
    <label class="form-label">Intended Suppliers</label>
    {{#each providers}}
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="provider_ids" value="{{this.provider_id}}" id="prov_{{this.provider_id}}">
        <label class="form-check-label" for="prov_{{this.provider_id}}">{{this.provider_name}}</label>
      </div>
    {{/each}}
  </div>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Save Draft RFQ</button>
    <a href="/rfqs" class="btn btn-secondary">Cancel</a>
  </div>
</form>